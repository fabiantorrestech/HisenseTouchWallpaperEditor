    <!-- See-through lock -->
    <string name="see_through_service_label">Touch Wallpaper see-through lock</string>
    <string name="see_through_service_description">Shows what was on your screen on the lock screen. While you use the device, it takes a screenshot each time the screen settles and makes it the lock screen wallpaper. Screenshots stay on this device and aren\'t saved anywhere else. Apps you hide in Touch Wallpaper are never shown.</string>
