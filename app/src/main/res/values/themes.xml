<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- E-ink look (default): black and white, no ripples, no elevation animation. -->
    <style name="Theme.TouchWallpaper" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#000000</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorControlActivated">#000000</item>
        <item name="colorControlNormal">#000000</item>
        <item name="colorControlHighlight">#00000000</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="materialButtonStyle">@style/EinkButton</item>
        <item name="alertDialogTheme">@style/EinkDialog</item>
    </style>

    <style name="EinkDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">#000000</item>
        <item name="colorControlHighlight">#00000000</item>
        <item name="buttonBarPositiveButtonStyle">@style/EinkDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/EinkDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/EinkDialogButton</item>
    </style>

    <style name="EinkDialogButton" parent="EinkButton">
        <item name="android:layout_marginStart">@dimen/gap_panel</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:layout_marginTop">@dimen/gap_button</item>
    </style>

    <!-- Standard look, for anyone who turns the e-ink look off in Settings. -->
    <style name="Theme.TouchWallpaper.Standard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/StandardButton</item>
    </style>

    <style name="StandardButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="EinkButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#000000</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">#000000</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#00000000</item>
    </style>

    <style name="StepButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">#000000</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#00000000</item>
    </style>

    <style name="RowButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/gap_button</item>
    </style>

    <style name="ButtonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/gap_section</item>
        <item name="android:layout_marginBottom">@dimen/gap_button</item>
    </style>
</resources>
