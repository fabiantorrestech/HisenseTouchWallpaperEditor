<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/gap_section">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/gap_button"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/gap_button"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/device_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/gap_button"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/new_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="@dimen/gap_button"
        android:layout_marginTop="20dp"
        android:text="@string/new_wallpaper"
        android:textSize="18sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/projects"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="@dimen/gap_button"
        android:layout_marginTop="@dimen/gap_section"
        android:text="@string/projects"
        android:textSize="18sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/restore_original"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/gap_button"
        android:layout_marginTop="@dimen/gap_section"
        android:text="@string/restore_original"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        style="@style/ButtonRow">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings"
            style="@style/RowButton"
            android:layout_height="56dp"
            android:text="@string/settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/help"
            style="@style/RowButton"
            android:layout_height="56dp"
            android:text="@string/help" />
    </LinearLayout>
</LinearLayout>
