<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_section"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="84dp"
        android:layout_height="168dp"
        android:background="#000000"
        android:contentDescription="@null"
        android:padding="1dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_panel"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:paddingHorizontal="@dimen/gap_button"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout style="@style/ButtonRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_crop"
                style="@style/RowButton"
                android:text="@string/step_crop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_zones"
                style="@style/RowButton"
                android:text="@string/step_zones" />
        </LinearLayout>

        <LinearLayout style="@style/ButtonRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rename"
                style="@style/RowButton"
                android:text="@string/rename" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/duplicate"
                style="@style/RowButton"
                android:text="@string/duplicate" />
        </LinearLayout>

        <LinearLayout style="@style/ButtonRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete"
                style="@style/RowButton"
                android:text="@string/delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/show_saved"
                style="@style/RowButton"
                android:text="@string/show_saved_file"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
