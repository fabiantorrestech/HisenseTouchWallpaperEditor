<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stepper_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stepper_minus"
            style="@style/StepButton"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/gap_panel"
            android:text="@string/minus" />

        <TextView
            android:id="@+id/stepper_value"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stepper_plus"
            style="@style/StepButton"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="@string/plus" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/stepper_slider"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/gap_button" />
</merge>
